# Configuração da implantação. Lida por implantar.sh e reverter.sh.
# Troque os trechos entre < > pelos valores do projeto.
# Comando que contém cifrão vai entre aspas simples, para ser avaliado só na hora de rodar.

RAMO=main

# Arquivo SQLite de produção e pasta das cópias feitas antes de cada implantação.
BANCO="<pasta de dados>/<arquivo>.db"
BACKUPS="<pasta de dados>/copias"
MANTER_BACKUPS=20

# Dependências e migração. Deixe MIGRAR vazio se o projeto não tiver.
INSTALAR=".venv/bin/pip install --quiet -r requirements.txt"
MIGRAR=""

# Reinício do serviço.
REINICIAR="sudo systemctl restart <servico>"

# Verificação depois do reinício. As duas precisam passar; deixe vazia a que não se aplica.
SAUDE_CMD="systemctl is-active --quiet <servico>"
SAUDE_URL="http://127.0.0.1:<porta>/<caminho que responde 200>"
SAUDE_TENTATIVAS=15
SAUDE_INTERVALO=2
